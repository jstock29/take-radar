{
  "manifest_version": 3,
  "name": "Bad Take Radar",
  "description": "Highlights signatories of the Harper's Letter and any other people who you think have bad takes on all websites.",
  "version": "0.4.0",
  "permissions": ["storage"],

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "names.js", "background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "action": {
    "default_title": "Take Radar",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}

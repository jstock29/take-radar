{
  "manifest_version": 3,
  "name": "Take Radar",
  "description": "Highlights the people you're keeping an eye on, on every website you visit.",
  "version": "0.7.0",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "shared.js",
      "additions.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "matcher.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Take Radar",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Pause or resume highlighting"
    }
  }
}
